# Copy to .env and fill in. .env is gitignored; never commit it.

# Your account identifier, as <orgname>-<accountname>
SNOWFLAKE_ACCOUNT=<your-account>

# An admin who can use SYSADMIN and SECURITYADMIN, with a programmatic access token. Used only by seed/seed.py.
SNOWFLAKE_ADMIN_USER=<your-admin-user>
SNOWFLAKE_ADMIN_TOKEN=<your-programmatic-access-token>
SNOWFLAKE_ADMIN_WAREHOUSE=COMPUTE_WH

# The agent's identity. seed/seed.py creates all of these and writes the key file.
SNOWFLAKE_USER=TECHNIK_AGENT_SVC
SNOWFLAKE_PRIVATE_KEY_FILE=keys/technik_agent_svc.p8
SNOWFLAKE_ROLE=TECHNIK_AGENT_RO
SNOWFLAKE_WAREHOUSE=TECHNIK_AGENT_WH
SNOWFLAKE_DATABASE=TECHNIK_DW
SNOWFLAKE_SCHEMA=OPS

# The agent's model: your Foundry project endpoint and a model deployment that supports function calling.
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL=gpt-4.1-mini
